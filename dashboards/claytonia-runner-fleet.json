{
  "uid": "claude-runner-fleet",
  "title": "Claytonia — Runner Fleet",
  "description": "Claytonia (agent fleet) observability: per-job cost, turns, and runtime from Loki job_complete events, plus a live open-PR review queue pulled from the GitHub API via the Infinity datasource. The uid keeps the legacy claude-runner-fleet name so existing links survive.",
  "tags": [
    "claytonia",
    "onprem"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 4,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "project",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values({job=\"claude_runner\"}, project)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "runid",
        "label": "run id",
        "type": "textbox",
        "description": "Regex over the runner run id (job_* events only). Default .* shows every run; claytonia deep-links with ?var-runid=<runid>.",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "options": [
          {
            "selected": true,
            "text": ".*",
            "value": ".*"
          }
        ]
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "enable": true,
        "expr": "{job=\"claude_runner\", project=~\"$project\"} | json | event=\"job_complete\" | status=\"success\" | label_format runtime=`{{ or .runtime \"claude\" }}`",
        "hide": false,
        "iconColor": "green",
        "name": "Task ended (success)",
        "step": "60s",
        "tagKeys": "project,runid,runtime",
        "textFormat": "done {{.runtime}} {{.project}} #{{.runid}}",
        "titleFormat": "Task complete",
        "type": "default"
      },
      {
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "enable": true,
        "expr": "{job=\"claude_runner\", project=~\"$project\"} | json | event=\"job_complete\" | status=\"failed\" | label_format runtime=`{{ or .runtime \"claude\" }}`",
        "hide": false,
        "iconColor": "red",
        "name": "Task ended (failed)",
        "step": "60s",
        "tagKeys": "project,runid,runtime",
        "textFormat": "failed {{.runtime}} {{.project}} #{{.runid}}",
        "titleFormat": "Task failed",
        "type": "default"
      },
      {
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "enable": true,
        "expr": "{job=\"claude_runner\", project=~\"$project\"} | json | event=\"job_started\" | label_format runtime=`{{ or .runtime \"claude\" }}`",
        "hide": false,
        "iconColor": "blue",
        "name": "Task started",
        "step": "60s",
        "tagKeys": "project,runid,runtime",
        "textFormat": "start {{.runtime}} {{.project}} #{{.runid}}",
        "titleFormat": "Task started",
        "type": "default"
      }
    ]
  },
  "panels": [
    {
      "id": 10,
      "type": "timeseries",
      "title": "Offload \u2014 concurrent runs (stacked, colored by model)",
      "description": "Concurrent Claude work, stacked so the total height is everything running at once. Headless runner runs are broken out and colored by model (opus / sonnet / haiku / fable / default) from the job_running heartbeat \u2014 distinct busy workers per model, 15s window. Local interactive sessions stack as a single grey 'local' band (session_running heartbeat, 2m window); the live heartbeat carries no model, so local runs are not model-attributed here. Where the local band falls and the model-colored runner bands rise is the offload handoff.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 35,
            "spanNulls": false,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "opus"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "sonnet"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "haiku"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "fable"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "default"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "local"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#808080"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range",
          "expr": "sum by (model) (max by (worker, model) (count_over_time({job=\"claude_runner\", project=~\"$project\"} | json | event=\"job_running\" | runid=~\"$runid\" [15s]) > bool 0))",
          "legendFormat": "{{model}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range",
          "expr": "sum(max by (worker, session_id) (count_over_time({job=\"claude_local\"} | json | event=\"session_running\" [2m]) > bool 0)) or vector(0)",
          "legendFormat": "local"
        }
      ]
    },
    {
      "id": 20,
      "type": "stat",
      "title": "Total spend (range)",
      "description": "Runner + local combined spend over the dashboard range (job_complete cost_usd from the fleet plus session_complete cost_usd from local sessions). A runner job whose cost is unknown (cost_usd null: a runtime that reports tokens only, or a failure that never produced a result) is left out of the sum and counted beside it as unpriced, never added as $0.",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "spend"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "runner jobs unpriced"
              },
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "expr": "sum(sum_over_time({job=~\"claude_runner|claude_local\"} | json | event=~\"job_complete|session_complete\" | cost_usd!=\"\" | unwrap cost_usd [$__range])) or vector(0)",
          "legendFormat": "spend"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "expr": "sum(count_over_time({job=\"claude_runner\"} | json | event=\"job_complete\" | cost_usd=\"\" [$__range])) or vector(0)",
          "legendFormat": "runner jobs unpriced"
        }
      ]
    },
    {
      "id": 200,
      "type": "row",
      "title": "Headcount & spend",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Runner jobs (range)",
      "description": "job_complete events over the dashboard range, by runtime. An event with no runtime label predates the label (claytonia#173) and is a Claude job.",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "expr": "sum by (runtime) (count_over_time({job=\"claude_runner\", project=~\"$project\"} | json | event=\"job_complete\" | label_format runtime=`{{ or .runtime \"claude\" }}` [$__range])) or on() vector(0)",
          "legendFormat": "{{runtime}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Runner spend (range)",
      "description": "Runner spend by runtime, and the number of runner jobs whose cost is unknown (cost_usd null). An unpriced job is left out of the spend, never counted as $0: until the dashboard prices tokens (#304), that is every job from a runtime that reports tokens only, plus any Claude failure that never produced a result. A range with no priced job reads \"no priced jobs\" at $0.00.",
      "gridPos": {
        "x": 6,
        "y": 15,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "jobs unpriced"
              },
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "values": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "expr": "sum by (runtime) (sum_over_time({job=\"claude_runner\", project=~\"$project\"} | json | event=\"job_complete\" | label_format runtime=`{{ or .runtime \"claude\" }}` | cost_usd!=\"\" | unwrap cost_usd [$__range])) or on() label_replace(vector(0), \"runtime\", \"no priced jobs\", \"\", \"\")",
          "legendFormat": "{{runtime}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "expr": "sum(count_over_time({job=\"claude_runner\", project=~\"$project\"} | json | event=\"job_complete\" | cost_usd=\"\" [$__range])) or vector(0)",
          "legendFormat": "jobs unpriced"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Runner success rate",
      "description": "Share of job_complete events with status success, by runtime. It is the average of a 0/1 flag rather than successes divided by jobs, so a runtime whose every job failed shows 0% instead of vanishing from the split. A range with no job_complete event reads \"no jobs\", never 100%.",
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "noValue": "no jobs",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "no jobs",
                  "color": "text",
                  "index": 0
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.8
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "expr": "avg_over_time({job=\"claude_runner\", project=~\"$project\"} | json | event=\"job_complete\" | label_format runtime=`{{ or .runtime \"claude\" }}`, ok=`{{ if eq .status \"success\" }}1{{ else }}0{{ end }}` | unwrap ok [$__range]) by (runtime)",
          "legendFormat": "{{runtime}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Runner PRs opened (range)",
      "gridPos": {
        "x": 18,
        "y": 15,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "expr": "sum(count_over_time({job=\"claude_runner\", project=~\"$project\"} | json | event=\"job_complete\" | pr_url!=\"\" [$__range])) or vector(0)"
        }
      ]
    },
    {
      "id": 101,
      "type": "stat",
      "title": "Local sessions (range)",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "expr": "sum(count_over_time({job=\"claude_local\"} | json | event=\"session_complete\" [$__range])) or vector(0)"
        }
