    {
      "id": 21,
      "type": "table",
      "title": "Runners underway (by submitter)",
      "description": "Jobs with a job_running beat in the last minute. submitter is a line field; \"-\" is a hand-dropped job. A beat with no runtime label predates the label (claytonia#173) and shows as claude.",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "format": "table",
          "expr": "label_replace(sum by (runid, worker, project, runtime, model, submitter) (count_over_time({job=\"claude_runner\", project=~\"$project\"} | json | event=\"job_running\" | runid=~\"$runid\" | label_format runtime=`{{ or .runtime \"claude\" }}` [1m])), \"submitter\", \"-\", \"submitter\", \"^$\")"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            },
            "indexByName": {
              "submitter": 0,
              "runid": 1,
              "project": 2,
              "runtime": 3,
              "model": 4,
              "worker": 5
            }
          }
        }
      ]
    },
    {
      "id": 22,
      "type": "table",
      "title": "Jobs by submitter (range)",
      "description": "job_complete events over the dashboard range, by submitter (line field). \"-\" is a hand-dropped job. Cost (USD) sums the priced jobs only; Unpriced counts the jobs whose cost is unknown (cost_usd null), and a submitter with no priced job shows its cost as unknown, not $0.",
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "format": "table",
          "expr": "label_replace(sum by (submitter) (count_over_time({job=\"claude_runner\", project=~\"$project\"} | json | runid=~\"$runid\" | event=\"job_complete\" [$__range])), \"submitter\", \"-\", \"submitter\", \"^$\")"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "format": "table",
          "expr": "label_replace(sum by (submitter) (sum_over_time({job=\"claude_runner\", project=~\"$project\"} | json | runid=~\"$runid\" | event=\"job_complete\" | cost_usd!=\"\" | unwrap cost_usd [$__range])), \"submitter\", \"-\", \"submitter\", \"^$\")"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "format": "table",
          "expr": "label_replace(sum by (submitter) (sum_over_time({job=\"claude_runner\", project=~\"$project\"} | json | runid=~\"$runid\" | event=\"job_complete\" | label_format unpriced=`{{ if .cost_usd }}0{{ else }}1{{ end }}` | unwrap unpriced [$__range])), \"submitter\", \"-\", \"submitter\", \"^$\")"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "Jobs",
              "Value #B": "Cost (USD)",
              "Value #C": "Unpriced"
            },
            "indexByName": {
              "submitter": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Cost (USD)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "noValue",
                "value": "unknown"
              }
            ]
          }
        ]
      }
