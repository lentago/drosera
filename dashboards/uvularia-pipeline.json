    {
      "id": 6,
      "type": "timeseries",
      "title": "Announcements — merge-to-live latency",
      "description": "For each publish that took an announcement live: the longest time from the announcement's merge to it being live (announcement_latency_s on uvularia_published). One point per publish; empty when no announcement has gone live in range.",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "no data",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "custom": {
            "drawStyle": "points",
            "pointSize": 8,
            "showPoints": "always",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
