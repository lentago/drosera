{
  "uid": "uvularia-pipeline",
  "title": "Uvularia — Records pipeline",
  "description": "uvularia operator pane: one row left to right — Intake, Reviewed, Published, Served, Asked — from the events each stage pushes to Loki (log_source=uvularia_<stage>, cluster=<org>), then announcement latency, the obligation timeline, and the demand loop. One JSON serves any org: pick it with the cluster variable. Every panel reads \"no data\" when its events are missing, never a fake green. Event contract: docs/clients/uvularia.md.",
  "tags": [
    "uvularia"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1m",
      "5m",
      "15m",
      "1h"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Org (cluster)",
        "type": "query",
        "description": "The owning org's slug — the cluster label every uvularia event carries.",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "definition": "label_values({source=\"uvularia\"}, cluster)",
        "query": "label_values({source=\"uvularia\"}, cluster)",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "sort": 1,
        "current": {
          "text": "lentago",
          "value": "lentago"
        },
        "options": []
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "enable": true,
        "hide": false,
        "iconColor": "green",
        "name": "Published",
        "expr": "{log_source=\"uvularia_published\", cluster=\"$cluster\"} | json",
        "step": "60s",
        "titleFormat": "Published",
        "textFormat": "digest {{.digest}}",
        "type": "default"
      },
      {
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "enable": true,
        "hide": false,
        "iconColor": "blue",
        "name": "Rules released",
        "expr": "{log_source=\"uvularia_rules_released\", cluster=\"$cluster\"} | json",
        "step": "60s",
        "titleFormat": "Rules released",
        "textFormat": "tag {{.tag}}",
        "type": "default"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Intake",
      "description": "Open intake Issues and PRs, and how long the oldest has waited. From the latest uvularia_intake event in 7 days (fields: open, oldest_opened_at). No event in 7 days reads \"no data\", never zero.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 7
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "no data",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "open"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "oldest waiting"
              },
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "none waiting",
                        "index": 0
                      }
                    }
                  }
                ]
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "wideLayout": true,
        "showPercentChange": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "queryType": "instant",
          "expr": "max(last_over_time({log_source=\"uvularia_intake\", cluster=\"$cluster\"} | json v=\"open\" | unwrap v | __error__=\"\" [7d]))",
          "legendFormat": "open"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "queryType": "instant",
          "expr": "max(last_over_time({log_source=\"uvularia_intake\", cluster=\"$cluster\"} | json v=\"oldest_opened_at\" | unwrap v | __error__=\"\" [7d])) * 1000",
          "legendFormat": "oldest"
        }
      ]
    },
